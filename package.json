{
  "name": "attendiq-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "import:php": "node --import tsx scripts/import-php.ts"
  },
  "dependencies": { "express": "^5.1.0", "bcryptjs": "^3.0.2", "nodemailer": "^7.0.0" },
  "devDependencies": { "typescript": "^5.9.3", "tsx": "^4.20.6", "@types/node": "^24.10.0", "@types/express": "^5.0.3", "@types/nodemailer": "^7.0.3" }
}
