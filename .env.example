NODE_ENV=development
HOST=127.0.0.1
PORT=3201
ATTENDIQ_STORAGE=.attendiq
# Set to 1 only behind the project's loopback reverse proxy.
TRUST_PROXY=0
# Exact comma-separated origins; prefer a same-origin gateway.
ALLOWED_ORIGINS=
# Shared with the same-origin gateway; generate 32 random bytes as 64 hex chars.
ATTENDIQ_GATEWAY_SECRET=
# Leave SMTP empty until configured privately.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
